
@inject GameState State


<!-- COLOR AND ACCESSIBILITY CONTROLS -->
<section class="game-settings" aria-labelledby="game-settings-heading">

    <h3 id="game-settings-heading">
        Game Settings
    </h3>

    <div class="color-controls">

        <label>
            Player 1 Color
            <input type="color" @bind="player1Color" @bind:event="oninput" aria-label="Select Player 1 piece color" />
        </label>

        <label>
            Player 2 Color
            <input type="color" @bind="player2Color" @bind:event="oninput" aria-label="Select Player 2 piece color" />
        </label>

        <label>
            Board Color
            <input type="color" @bind="boardColor" @bind:event="oninput" aria-label="Select board color" />
        </label>

    </div>

    <label class="contrast-control">
        <input type="checkbox" @bind="highContrast" />

        High Contrast Mode
    </label>

</section>






<!-- GAME STATUS -->
<article class="game-status">

    <span class="current-turn">
        @CurrentTurn
    </span>

    @if (!string.IsNullOrEmpty(winnerMessage))
    {
        <span class="winner-message">
            @winnerMessage
        </span>

        <button class="reset-button" @onclick="ResetGame">
            Reset Game
        </button>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <span class="error-message">
            @errorMessage
        </span>
    }

</article>


<!-- GAME BOARD -->
<div class="game-container @(highContrast ? "high-contrast" : "")" style="
    --board-bg: @boardColor;
    --player1: @player1Color;
    --player2: @player2Color;
    ">

    <nav class="column-selectors">
        @for (byte i = 0; i < 7; i++)
        {
            var col = i;

            <button class="column-button" title="Click to play a piece" @onclick="() => PlayPiece(col)">
                🔽
            </button>
        }
    </nav>

    <div class="board">
        @for (var i = 0; i < 42; i++)
        {
            <span class="container">
                <span class="hole"></span>
            </span>
        }

        @for (var i = 0; i < 42; i++)
        {
            <span class="piece @pieces[i]"></span>
        }
    </div>

</div>




<!-- MOVE HISTORY -->
<section class="move-history">

    <h3>Move History</h3>

    @if (moveHistory.Count == 0)
    {
        <p>No moves have been made yet.</p>
    }
    else
    {
        <ol>
            @foreach (var move in moveHistory)
            {
                <li>@move</li>
            }
        </ol>
    }

</section>





@code {


    private string[] pieces = new string[42];

    private string winnerMessage = string.Empty;
    private string errorMessage = string.Empty;

   // Move history list to keep track of the moves made during the game.
    private List<string> moveHistory = new();


// Color settings for players and board.
    private string player1Color = "#ff0000";
    private string player2Color = "#0000ff";
    private string boardColor = "#ffd700";

    private bool highContrast = false;



    private string CurrentTurn => (winnerMessage == string.Empty) ? $"Player {State.PlayerTurn}'s Turn" : "";
    private string ResetStyle => (winnerMessage == string.Empty) ? "display: none;" : "";

    
    
    
    
    protected override void OnInitialized()
    {
        State.ResetBoard();
    }



// Handle the logic for playing a piece in the specified column.
    private void PlayPiece(byte col)
    {
        try
        {
            var player = State.PlayerTurn;
            var turn = State.CurrentTurn;

            var landingRow = State.PlayPiece(col);

           // Update the pieces array to reflect the new piece's position
            pieces[turn] =
                $"player{player} col{col} drop{landingRow}";

          
          // Add the move to the move history list
            moveHistory.Add(
                $"Player {player} → Column {col + 1}, Row {landingRow}"
            );

            // Clear previous error after successful move
            errorMessage = string.Empty;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }

       
       // Check for a winner after the move and update the winner message accordingly
        winnerMessage = State.CheckForWin() switch
        {
            GameState.WinState.Player1_Wins =>
                "Player 1 Wins!",

            GameState.WinState.Player2_Wins =>
                "Player 2 Wins!",

            GameState.WinState.Tie =>
                "It's a tie!",

            _ => ""
        };
    }


// Reset the game state, clear messages, and reset the pieces array and move history.
private void ResetGame()
    {
        State.ResetBoard();
        winnerMessage = string.Empty;
        errorMessage = string.Empty;
        pieces = new string[42];

        moveHistory.Clear();
   
   
   
    }

    



}
